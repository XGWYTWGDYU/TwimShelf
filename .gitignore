*.xcodeproj/xcuserdata/
build/
.DS_Store
.swiftpm/
__pycache__/
.claude/
*.xcresult
# personal files that sit in the project folder (diagnostics exports, screenshots, stray output)
/*.zip
/*.heic
/1
*.xcodeproj/project.xcworkspace/xcuserdata/
/*.mov

# Builds: everything goes to build.dir of config.yaml (<dir>/cache, <dir>/apps; default build/).
# These are links from the Flutter projects into that cache, made by scripts/apply.py.
/flutter/*/.dart_tool
/flutter/app/build
/flutter/installer/build
/flutter/app/android/.gradle
/flutter/app/ios/Pods
/flutter/app/macos/Pods
/flutter/tl_llama/android/.cxx
/flutter/tl_core/apple
/flutter/tl_core/android/src/main/jniLibs
/flutter/tl_core/windows/lib
/flutter/tl_core/linux/lib
/flutter/tl_*/pubspec.lock
/flutter/installer/pubspec.lock
/flutter/app/android/local.properties
# this computer's own values (see config.local.example.yaml) and private files
/config.local.yaml
/.local/

# made by scripts/apply.py from config.yaml (+ config.local.yaml): never edit, never commit
/TwimShelf.xcodeproj/*
# …except the Swift packages' pinned versions, which Xcode keeps inside it
!/TwimShelf.xcodeproj/project.xcworkspace/
/TwimShelf.xcodeproj/project.xcworkspace/*
!/TwimShelf.xcodeproj/project.xcworkspace/xcshareddata/
/TwimShelf.xcodeproj/project.xcworkspace/xcshareddata/*
!/TwimShelf.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/native/Identity.xcconfig
/native/Resources/Assets.xcassets/AppIconLocal.appiconset/
/flutter/app/ios/Flutter/Identity.xcconfig
/flutter/app/macos/Runner/Configs/Identity.xcconfig
/flutter/app/android/identity.properties
/flutter/app/linux/identity.cmake
/flutter/app/lib/app/identity.g.dart
/flutter/installer/product.json
**/BuildLocation.xcconfig
/native/.applied.json

# Rust (the workspace's own target folder; scripts build into build.dir instead)
/target/

# signing keys never live here (see BUILDING.md); a build writes key.properties only for itself
/flutter/app/android/key.properties
*.jks
*.keystore


# icons: made from native/Resources/Assets.xcassets/AppIcon.appiconset by scripts/flutter/make_icons.py
/flutter/app/android/app/src/main/res/mipmap-*/*.png
/flutter/app/ios/Runner/Assets.xcassets/AppIcon.appiconset/*.png
/flutter/app/macos/Runner/Assets.xcassets/AppIcon.appiconset/*.png
/flutter/app/assets/app_icon.png
/flutter/installer/assets/app_icon.png
