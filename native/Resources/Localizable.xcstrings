          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには現在このモデルを動かすだけの空きメモリがありません（約 %@ 必要、空き %@）。モデルは読み込まれませんでした。同じアカウントのほかのデバイスがタグ付けを続け、結果が同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备现在的可用内存不够运行这个模型（需要约 %@，可用 %@）。没有加载模型；同一账户里的其他设备会继续标记，结果会同步过来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
