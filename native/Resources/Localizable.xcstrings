    "settings.backup.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup holds all media (Recently Deleted included), text, tags, folders and rename rules — not AI models, sorting history or device pairing. To restore, import the .tlpack on any device. To export part of the library: search in Browse, then use the export button beside the search field."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップにはすべてのメディア（ゴミ箱を含む）、本文、タグ、フォルダ、名前変更ルールが含まれます（AI モデル、整理履歴、デバイスのペアリングは含まれません）。復元するには任意のデバイスで .tlpack を読み込みます。一部だけ書き出すには「ブラウズ」で検索し、検索フィールド横の書き出しボタンを使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份包含全部媒体（含回收站）、正文、标签、文件夹和改名规则，不含 AI 模型、整理记录和设备配对。恢复时在任意设备上导入 .tlpack 即可。要导出一部分内容：在「浏览」里搜索，再点搜索框旁的导出按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份包含全部媒體（含垃圾桶）、內文、標籤、資料夾和改名規則，不含 AI 模型、整理記錄和裝置配對。還原時在任意裝置上匯入 .tlpack 即可。要匯出部分內容：在「瀏覽」裡搜尋，再點搜尋框旁的匯出按鈕。"
          }
        }
      }
    },
