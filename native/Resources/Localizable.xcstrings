    "models.external.connection.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only an address = a local service (Ollama, LM Studio…; without a model name, the service's first model is used). An API key and a model name = a cloud model. The API key stays in this device's keychain and isn't synced."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスだけ＝ローカルサービス（Ollama、LM Studio など。モデル名がなければサービスの最初のモデルを使用）。API キーとモデル名＝クラウドモデル。API キーはこのデバイスのキーチェーンだけに保存され、同期されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只填地址 = 本地服务（Ollama、LM Studio 等，模型名称不填时用服务上的第一个模型）。填了 API Key 和模型名称 = 云端模型。API Key 只保存在这台设备的钥匙串里，不会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只填位址 = 本機服務（Ollama、LM Studio 等，模型名稱不填時用服務上的第一個模型）。填了 API Key 和模型名稱 = 雲端模型。API Key 只儲存在這台裝置的鑰匙圈裡，不會同步。"
          }
        }
      }
    },
