    "search.fuzzy.needsModel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuzzy search by meaning needs a semantic search model: download and choose one in AI Models first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味によるあいまい検索には意味検索モデルが必要です。先に「AI モデル」でダウンロードして選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语义模糊搜索需要语义搜索模型：先在「AI 模型」中下载并选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語意模糊搜尋需要語意搜尋模型：先在「AI 模型」中下載並選擇一個。"
          }
        }
      }
    },
    "search.guide" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type %@ followed by a space to make a condition capsule; any other word followed by a space becomes a capsule to search for, in any order. A folder's name follows “Folder”. A minus in front takes something away: “-cat” leaves out media containing cat, “-User” doesn't search in users, “-Folder Trip” leaves out a folder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のあとにスペースを入力すると条件のカプセルになります。ほかの語はスペースで検索語のカプセルになり、条件と自由に組み合わせられます。「フォルダ」のあとにはフォルダ名を続けます。前にマイナスを付けると除外：「-猫」は猫を含むメディアを除き、「-ユーザー」はユーザーからは探さず、「-フォルダ 旅行」はそのフォルダを除きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入%@后按空格，变成条件胶囊；其他词按空格变成要搜索的内容，可以和条件穿插。「文件夹」后面接文件夹名。前面加减号表示排除：「-猫」排除含有猫的媒体，「-用户」不在用户里找，「-文件夹 旅行」排除一个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入%@後按空白鍵，變成條件膠囊；其他詞按空白鍵變成要搜尋的內容，可以和條件穿插。「資料夾」後面接資料夾名稱。前面加減號表示排除：「-貓」排除含有貓的媒體，「-使用者」不在使用者裡找，「-資料夾 旅行」排除一個資料夾。"
          }
        }
      }
    },
