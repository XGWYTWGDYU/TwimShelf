    "mac.importHistory.deleteMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afterwards these records can't be viewed and their problem files can't be exported from them. Problem files kept in the app from imports via Share are deleted too; original files you imported from elsewhere on this Mac are not."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除するとこれらの記録は表示できず、記録から問題ファイルを書き出すこともできなくなります。「共有」から読み込んだときにアプリ内に残した問題ファイルも削除されます。この Mac のほかの場所から読み込んだ元のファイルは削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后无法再查看这些记录，也不能再从记录里导出问题文件。通过「分享」导入时留在 App 里的问题文件会一起删除；你从这台 Mac 其他位置导入的原始文件不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除後無法再查看這些記錄，也不能再從記錄裡匯出問題檔案。透過「分享」匯入時留在 App 裡的問題檔案會一起刪除；你從這台 Mac 其他位置匯入的原始檔案不會被刪除。"
          }
        }
      }
    },
