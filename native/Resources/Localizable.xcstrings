    "sync.newerOps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} on another device is newer than this one: some sync records it sent can't be read by this version yet. They are kept and passed on to other devices, nothing is lost; they take effect once this device is updated."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスの {app} がこのデバイスより新しいため、受け取った同期記録の一部をこのバージョンでは読めません。記録は保存され、ほかのデバイスへ転送されるので失われません。このデバイスをアップデートすると自動で反映されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备上的 {app} 比这台新：收到的部分同步记录这个版本还看不懂。它们已经保存，并会继续转发给其他设备，不会丢失；把这台设备更新到最新版本后会自动生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台裝置上的 {app} 比這台新：收到的部分同步記錄這個版本還看不懂。它們已經儲存，並會繼續轉發給其他裝置，不會遺失；把這台裝置更新到最新版本後會自動生效。"
          }
        }
      }
    },
    "sync.noLocalNetwork" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't Access the Local Network"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークにアクセスできません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问本地网络"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法存取區域網路"
          }
        }
      }
    },
    "sync.noLocalNetwork.ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} has no Local Network permission, so it can't find or reach other devices. Turn on {app} in Settings › Privacy & Security › Local Network, then come back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} に「ローカルネットワーク」の許可がないため、ほかのデバイスを見つけたり接続したりできません。「設定 › プライバシーとセキュリティ › ローカルネットワーク」で {app} をオンにしてから戻ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} 没有「本地网络」权限，无法发现和连接其他设备。请在「设置 › 隐私与安全性 › 本地网络」中打开 {app}，然后回到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} 沒有「區域網路」權限，無法發現和連線其他裝置。請在「設定 › 隱私權與安全性 › 區域網路」中開啟 {app}，然後回到這裡。"
          }
        }
      }
    },
    "sync.noLocalNetwork.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} has no Local Network permission, so it can't find or reach other devices. Turn on {app} in System Settings › Privacy & Security › Local Network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} に「ローカルネットワーク」の許可がないため、ほかのデバイスを見つけたり接続したりできません。「システム設定 › プライバシーとセキュリティ › ローカルネットワーク」で {app} をオンにしてください。"
          }
        },
