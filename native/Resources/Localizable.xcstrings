          }
        }
      }
    },
    "mac.wipe.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All posts, media, tags, cookies and sync settings will be permanently deleted and can't be recovered. Installed AI models are kept by default (no need to download them again)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての投稿・メディア・タグ・Cookie・同期設定が完全に削除され、元に戻せません。インストール済みの AI モデルはデフォルトで残ります（再ダウンロード不要）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部帖子、媒体、标签、Cookie 和同步配置都会被永久删除，无法恢复。已安装的 AI 模型默认保留（不必重新下载）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部貼文、媒體、標籤、Cookie 和同步設定都會被永久刪除，無法恢復。已安裝的 AI 模型預設保留（不必重新下載）。"
          }
        }
      }
    },
