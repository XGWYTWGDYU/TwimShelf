    "mac.backup.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For cold backups: all media (Recently Deleted too), post text, tags and their sources, AI analysis records, folders (empty ones too), tag rename rules and “Recently Added” marks. Not AI models, sorting history, device pairing or import history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コールドバックアップ用：すべてのメディア（ゴミ箱も含む）、投稿本文、タグとその提供元、AI の分析記録、フォルダ（空のものも）、タグの名前変更ルール、「最近追加」の印。AI モデル、整理履歴、デバイスのペアリング、読み込み履歴は含みません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于冷备份：所有媒体（也包括回收站里的）、帖子正文、标签及其来源、AI 分析记录、文件夹（包括空文件夹）、标签改名规则和「最近添加」标记。不含 AI 模型、整理记录、设备配对和导入记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於冷備份：所有媒體（也包括垃圾桶裡的）、貼文內文、標籤及其來源、AI 分析記錄、資料夾（包括空資料夾）、標籤改名規則和「最近新增」標記。不含 AI 模型、整理記錄、裝置配對和匯入記錄。"
          }
        }
      }
    },
    "mac.backup.fileName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} Backup %@.tlpack"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} バックアップ %@.tlpack"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{app} 备份 %@.tlpack"
