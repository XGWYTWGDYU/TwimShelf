    "mac.wipe.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes all posts, media, tags, cookies and sync settings on this Mac and starts fresh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のすべての投稿・メディア・タグ・Cookie・同期設定を削除して初期状態に戻します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
