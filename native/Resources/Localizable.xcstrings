    "models.external.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI-compatible APIs (OpenAI, Grok, OpenRouter, Ollama, LM Studio…). Only an address means a local service; an API key and a model name mean a cloud model. The list of models syncs between devices; API keys stay in each device's own keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 互換 API（OpenAI、Grok、OpenRouter、Ollama、LM Studio など）。アドレスだけならローカルサービス、API キーとモデル名があればクラウドモデルです。モデルの一覧はデバイス間で同期され、API キーは各デバイスのキーチェーンだけに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 兼容接口（OpenAI、Grok、OpenRouter、Ollama、LM Studio 等）。只填地址是本地服务；填了 API Key 和模型名称是云端模型。模型列表在设备间同步，API Key 只保存在各自设备的钥匙串里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 相容介面（OpenAI、Grok、OpenRouter、Ollama、LM Studio 等）。只填位址是本機服務；填了 API Key 和模型名稱是雲端模型。模型列表在裝置間同步，API Key 只儲存在各自裝置的鑰匙圈裡。"
          }
        }
      }
    },
