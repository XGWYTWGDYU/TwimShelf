    "settings.maintenance.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A check verifies every file to find damaged or missing media. Diagnostics contain only error records and counts — no pictures, text, tag names or cookies."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックではファイルを 1 つずつ照合し、破損・欠落したメディアを見つけます。診断情報にはエラー記録と件数だけが含まれ、画像・本文・タグ名・Cookie は含まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查会逐个核对文件，找出损坏或丢失的媒体。诊断信息只含错误记录和数量，不含图片、正文、标签名或 Cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查會逐一核對檔案，找出損壞或遺失的媒體。診斷資訊只含錯誤記錄和數量，不含圖片、內文、標籤名稱或 Cookie。"
          }
        }
      }
    },
