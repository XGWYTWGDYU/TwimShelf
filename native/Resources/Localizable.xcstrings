    "models.appleOnly.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting, importing and pulling models work between Apple devices only: these MLX models run on Apple silicon alone. Android, Windows and Linux download their own models."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルの書き出し・読み込み・ほかのデバイスからの取得は Apple デバイス間でのみ使えます。これらの MLX モデルは Apple シリコンでしか動きません。Android、Windows、Linux はそれぞれのモデルをダウンロードします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出、导入和从其他设备拉取模型仅限 Apple 设备之间使用：这些 MLX 模型只能在 Apple 芯片上运行。Android、Windows 和 Linux 会下载各自的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯出、匯入和從其他裝置拉取模型僅限 Apple 裝置之間使用：這些 MLX 模型只能在 Apple 晶片上執行。Android、Windows 和 Linux 會下載各自的模型。"
          }
        }
      }
    },
