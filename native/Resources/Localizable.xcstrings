    "settings.search.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the search field, type a condition word (Tags, Text, User, Mine, AI, Common, Videos, Photos, Folder, Recent, Imported) and a space to make it a condition capsule; any other word and a space becomes something to search for, in any order. Without Tags, Text or User, tags, post text and authors are all searched. A minus in front leaves something out (-word, -User). Fuzzy search: matches what contains the word, plus tags close in meaning."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドに条件語（タグ・本文・ユーザー・自分・AI・共通・動画・写真・フォルダ・最近・外部読み込み）を入力してスペースを押すと条件のカプセルになります。ほかの語はスペースで検索語になり、条件と自由に組み合わせられます。タグ・本文・ユーザーを指定しないときは、タグ・投稿本文・作者をまとめて検索します。前にマイナスを付けると除外します（-語、-ユーザー）。あいまい検索：その語を含むものに加え、意味の近いタグも探します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜索框里输入「标签」「贴文」「用户」「我的」「AI」「共同」「视频」「照片」「文件夹」「最近」「外部导入」后按空格，它们会变成条件胶囊；其他词按空格变成要搜索的内容，可以和条件穿插。不加「标签」「贴文」「用户」时，在标签、帖子正文和作者里一起找。语义模糊搜索：包含匹配，并找意思相近的标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜尋框輸入「標籤」「貼文」「使用者」「我的」「AI」「共同」「影片」「照片」「資料夾」「最近」「外部匯入」後按空白鍵，會變成條件膠囊；其他詞按空白鍵變成要搜尋的內容，可以和條件穿插。不加「標籤」「貼文」「使用者」時，會同時在標籤、貼文內文和作者裡找。前面加減號表示排除（-詞、-使用者）。語意模糊搜尋：包含比對，並找意思相近的標籤。"
          }
        }
      }
    },
