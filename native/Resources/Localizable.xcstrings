    "models.import.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import any standard MLX model folder or its ZIP (exported on another device and AirDropped, say) instead of downloading it again. Between Apple devices only: MLX models run on Apple silicon alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準の MLX モデルフォルダやその ZIP（別のデバイスで書き出して AirDrop したものなど）を読み込めば、再ダウンロードを避けられます。Apple デバイス間のみ：MLX モデルは Apple シリコンでしか動きません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可导入任意标准 MLX 模型文件夹，或其 ZIP（例如从另一台设备导出后隔空投送过来的），避免重复下载。仅限 Apple 设备之间使用：MLX 模型只能在 Apple 芯片上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可匯入任意標準 MLX 模型資料夾，或其 ZIP（例如從另一台裝置匯出後 AirDrop 過來的），避免重複下載。僅限 Apple 裝置之間使用：MLX 模型只能在 Apple 晶片上執行。"
          }
        }
      }
    },
