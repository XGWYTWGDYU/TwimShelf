    "mac.search.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type these words in the search field and a space to make condition capsules; other words are what to search for, in any order. A minus in front (-word, -User) leaves something out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドにこれらの語を入力してスペースを押すと条件のカプセルになります。ほかの語は検索語で、条件と自由に組み合わせられます。前にマイナスを付けると除外します（-語、-ユーザー）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜索框里输入这些词，按空格变成条件胶囊；其他词是要搜索的内容，可以和条件穿插。前面加减号（-词、-用户）表示排除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜尋框輸入這些詞，按空白鍵變成條件膠囊；其他詞是要搜尋的內容，可以和條件穿插。前面加減號（-詞、-使用者）表示排除。"
          }
        }
      }
    },
