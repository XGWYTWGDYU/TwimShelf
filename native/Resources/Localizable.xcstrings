    "models.simulator.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running in the iOS Simulator, where Metal inference isn't available. Models can be managed, imported and exported, but tagging and semantic search need a real device or a Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS シミュレータで実行中のため、Metal 推論は使えません。モデルの管理と読み込み・書き出しはできますが、タグ付けと意味検索には実機または Mac が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前运行在 iOS 模拟器中，Metal 推理不可用。模型可以管理与导入导出，但打标签与语义搜索需要在真机或 Mac 上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前在 iOS 模擬器中執行，Metal 推理無法使用。模型可以管理與匯入匯出，但加標籤與語意搜尋需要在實機或 Mac 上執行。"
          }
        }
      }
    },
