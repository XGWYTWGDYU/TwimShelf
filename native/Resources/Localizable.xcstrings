    "tag.rename.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every item with this tag uses the new name; if the new name exists already, the two merge. Running AI tagging and other devices use the new name too. It can be undone later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタグが付いたすべてのメディアが新しい名前になります。新しい名前がすでにあれば 2 つは統合されます。実行中の AI タグ付けやほかのデバイスも新しい名前を使います。あとで取り消せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有带这个标签的媒体都会改用新名字；如果新名字已经存在，两者会合并。正在进行的 AI 标记和其他设备也会自动使用新名字，之后可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有帶這個標籤的媒體都會改用新名稱；如果新名稱已經存在，兩者會合併。正在進行的 AI 標記和其他裝置也會自動使用新名稱，之後可以撤銷。"
          }
        }
      }
    },
    "tag.rename.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rename Tag “%@”"
          }
        },
