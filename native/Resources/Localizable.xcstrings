    "settings.batch.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a bookmarks JSON exported by the Twitter Web Exporter userscript; posts are downloaded one by one. Concurrency is how many posts download at once; the interval is the wait before each post starts. With many posts, lower concurrency and a longer interval are safer. Starting again after an interruption continues with the unfinished posts. Method and folder follow the settings at the top."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザースクリプト Twitter Web Exporter で書き出したブックマーク JSON を選ぶと、1 件ずつダウンロードします。同時実行数は同時にダウンロードする投稿数、間隔は各投稿の開始前に待つ時間です。投稿が多いときは同時実行数を下げ、間隔を長くすると安定します。中断後に再開すると未完了の投稿から続けます。方法とフォルダは一番上の設定に従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择油猴脚本 Twitter Web Exporter 导出的收藏夹 JSON，逐条下载。并发数是同时下载几个帖子，间隔是每个帖子开始前等待的时间；帖子多时调低并发、加大间隔更稳妥。中断后再次开始会从未完成的帖子继续。下载方式和文件夹沿用最上面的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇使用者腳本 Twitter Web Exporter 匯出的書籤 JSON，逐則下載。並行數是同時下載幾則貼文，間隔是每則貼文開始前等待的時間；貼文多時調低並行數、加大間隔更穩妥。中斷後再次開始會從未完成的貼文繼續。下載方式和資料夾沿用最上方的設定。"
          }
        }
      }
    },
