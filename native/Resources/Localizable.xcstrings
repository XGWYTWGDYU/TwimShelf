    "mac.backup.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Written as it is read; every file's checksum is verified, and damaged or missing files are listed. To restore, import the .tlpack on any device. To export part of the library: search in Browse, then use the export button beside the search field."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みながら書き込み、各ファイルのチェックサムを照合します。破損・欠落したファイルは個別に一覧表示されます。復元は任意のデバイスで .tlpack を読み込むだけです。一部だけ書き出すには「ブラウズ」で検索し、検索フィールド横の書き出しボタンを使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "边读边写，每个文件都会核对校验值，损坏或缺失的文件会单独列出。恢复时在任意设备上「导入 .tlpack」即可。要导出一部分内容：在「浏览」里搜索，再点搜索框旁的导出按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邊讀邊寫，每個檔案都會核對校驗值，損壞或缺少的檔案會單獨列出。還原時在任意裝置上「匯入 .tlpack」即可。要匯出部分內容：在「瀏覽」裡搜尋，再點搜尋框旁的匯出按鈕。"
          }
        }
      }
    },
