    "applock.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not verify"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "认证没有通过"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證沒有通過"
          }
        }
      }
    },
    "applock.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the app asks every time it opens. If that fails you can use the device's passcode or password. This keeps people out of the app; it does not encrypt the library's files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、アプリを開くたびに認証を求めます。認証できないときはデバイスのパスコードやパスワードも使えます。アプリの利用を防ぐ機能で、ライブラリのファイルは暗号化されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每次打开应用都要先通过认证；认证不了时可以改用设备密码。它只拦住打开应用的人，不会加密资料库文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，每次開啟 App 都要先通過驗證；無法驗證時可以改用裝置密碼。它只攔住開啟 App 的人，不會加密資料庫檔案。"
          }
        }
      }
    },
