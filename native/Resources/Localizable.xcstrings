    "diag.abnormal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last run (version %@) didn't end normally: a crash, termination by the system (low memory, for example) or a force quit"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の実行（バージョン %@）は正常に終了しませんでした：クラッシュ、システムによる終了（メモリ不足など）、または強制終了"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次运行（版本 %@）没有正常结束：崩溃、被系统终止（例如内存不足）或被强制退出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次執行（版本 %@）沒有正常結束：當機、被系統終止（例如記憶體不足）或被強制結束"
          }
        }
      }
    },
    "diag.contents" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contains: the problem log (time, module and reason of errors and warnings), the statistics log (numbers only), crash diagnostics, device model and OS version, app version, library counts and switch settings, import record counts. Does not contain: pictures, videos, post text, authors, tag names, file names, cookies or sync credentials."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含まれるもの：問題ログ（エラーと警告の時刻・モジュール・理由）、統計ログ（数字のみ）、クラッシュ診断、デバイスの機種と OS バージョン、アプリのバージョン、ライブラリの件数と設定、読み込み記録の件数。含まれないもの：画像、動画、投稿本文、作者、タグ名、ファイル名、Cookie、同期の認証情報。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含：问题日志（错误和警告的时间、模块、原因）、统计日志（只有数字）、崩溃诊断、设备型号和系统版本、App 版本、资料库的数量统计和开关设置、导入记录的数量统计。不包含：图片、视频、帖子正文、作者、标签名、文件名、Cookie 或同步凭据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含：問題日誌（錯誤和警告的時間、模組、原因）、統計日誌（只有數字）、當機診斷、裝置型號和系統版本、App 版本、資料庫的數量統計和開關設定、匯入記錄的數量統計。不包含：圖片、影片、貼文內文、作者、標籤名稱、檔案名稱、Cookie 或同步憑證。"
          }
        }
      }
    },
