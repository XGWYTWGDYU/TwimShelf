    "models.peers.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models don't sync on their own. Listed here are models that online devices of the same sync account have and this one doesn't; tapping one fetches it over the local network and installs it once verified. Between Apple devices only: MLX models run on Apple silicon alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは自動では同期されません。同じ同期アカウントのオンラインのデバイスにあって、このデバイスにないモデルを表示します。タップすると LAN 経由で取得し、検証後にインストールします。Apple デバイス間のみ：MLX モデルは Apple シリコンでしか動きません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型不会自动同步。这里列出同一同步账户、当前在线的设备上有而本机没有的模型，点击后才会通过局域网拉取，并在校验通过后安装。仅限 Apple 设备之间使用：MLX 模型只能在 Apple 芯片上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型不會自動同步。這裡列出同一同步帳戶、目前在線的裝置上有而本機沒有的模型，點擊後才會透過區域網路拉取，並在校驗通過後安裝。僅限 Apple 裝置之間使用：MLX 模型只能在 Apple 晶片上執行。"
          }
        }
      }
    },
