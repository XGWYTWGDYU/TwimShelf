    "import.delete.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes this record. The source copies the app kept for this import (the ZIP the system copied in when picked in Files, problem files left by Share) are deleted too, freeing space; problem files can no longer be exported from here afterwards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この記録を削除します。読み込み時にアプリが保存した読み込み元のコピー（「ファイル」で選んだときにシステムがコピーした ZIP、共有で残した問題ファイル）も削除され、空き容量が増えます。削除後はここから問題ファイルを書き出せなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除这条记录。导入时 App 保存的来源副本（从「文件」选取时系统复制给 App 的 ZIP、分享时留下的问题文件）会一起删除，释放空间；删除后不能再从这里导出问题文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除這條記錄。匯入時 App 儲存的來源副本（從「檔案」選取時系統拷貝給 App 的 ZIP、分享時留下的問題檔案）會一起刪除，釋放空間；刪除後不能再從這裡匯出問題檔案。"
          }
        }
      }
    },
    "import.deleteAll" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete All Import Records…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての読み込み記録を削除…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除全部导入记录…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除全部匯入記錄…"
          }
        }
      }
    },
    "import.deleteAll.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afterwards they can't be viewed and their problem files can't be exported. Source copies kept in the app are deleted too; your original files in Files are not affected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると表示できず、問題ファイルも書き出せなくなります。アプリ内の読み込み元のコピーも削除されます。「ファイル」にある元のファイルには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后无法再查看，也不能再导出其中的问题文件。App 里保存的来源副本会一起删除；你在「文件」里的原始文件不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除後無法再查看，也不能再匯出其中的問題檔案。App 裡儲存的來源副本會一起刪除；你在「檔案」裡的原始檔案不受影響。"
          }
        }
      }
    },
