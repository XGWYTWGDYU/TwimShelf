    "mac.cookie.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for posts of protected accounts. Sign in to x.com in a browser and copy auth_token and ct0 from the developer tools' cookies. Stored only in this Mac's keychain, never synced."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵アカウントの投稿をダウンロードするときに使います。ブラウザで x.com にログインし、開発者ツールの Cookie から auth_token と ct0 をコピーします。この Mac のキーチェーンだけに保存され、同期されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载锁定账号的帖子时使用。在浏览器登录 x.com，从开发者工具的 Cookie 中复制 auth_token 与 ct0。仅保存在本机钥匙串，不会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載鎖定帳號的貼文時使用。在瀏覽器登入 x.com，從開發者工具的 Cookie 中拷貝 auth_token 與 ct0。只儲存在本機鑰匙圈，不會同步。"
          }
        }
      }
    },
