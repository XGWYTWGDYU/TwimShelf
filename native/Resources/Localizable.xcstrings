        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All posts, media, tags, cookies and sync settings on this device will be permanently deleted and can't be recovered. Other devices are not affected.\nInstalled AI models are kept by default (no need to download them again)."
