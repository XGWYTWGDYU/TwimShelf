    "models.tagging.controls" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause stops after the current picture and keeps your place. Stop gives up all of it, and automatic tagging rests until you turn it on again or reopen the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止：現在の 1 枚を終えてから止まり、進捗は保持されます。停止：すべて取りやめ、スイッチを入れ直すか次に起動するまで自動タグ付けも行いません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停：做完当前这张后停下，进度保留。停止：放弃所有任务，自动标记也先不运行，直到重新打开开关或下次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停：做完目前這張後停下，進度保留。停止：放棄所有工作，自動標記也先不執行，直到重新打開開關或下次啟動。"
          }
        }
      }
    },
    "models.tagging.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only media no model has analyzed yet are tagged automatically; changing the default model doesn't re-tag. Re-tag one item from its long-press menu when needed, or everything here. Tags you added or approved are never deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動でタグ付けされるのは、まだどのモデルも分析していないメディアだけです。デフォルトのモデルを変えても再タグ付けはしません。必要なら長押しメニューで個別に、またはここで全体を再タグ付けできます。自分で付けた・承認したタグは削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有尚未被任何模型分析过的媒体会被自动标记，更换默认模型不会重新标记。需要时可在照片的长按菜单中单独重新标记，或在这里全部重新标记。你添加或认可的标签永远不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有尚未被任何模型分析過的媒體會被自動標記，更換預設模型不會重新標記。需要時可在照片的長按選單中單獨重新標記，或在這裡全部重新標記。你加入或認可的標籤永遠不會被刪除。"
          }
        }
      }
    },
