    "settings.method.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the links below and to batch bookmark imports. “Automatic” tries the public mirror FxTwitter first; when that fails (a protected account, say) and a cookie is set, it downloads with the account. Posts already in the library go into the chosen folder too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のリンクのダウンロードとブックマークの一括読み込みの両方に適用されます。「自動」はまず公開ミラーの FxTwitter を使い、取得できない場合（鍵アカウントなど）で Cookie が設定されていればアカウントでダウンロードします。ライブラリにある投稿も選んだフォルダに入ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对下面的链接下载和批量导入收藏夹都生效。「自动」先用公开镜像 FxTwitter，拿不到时（例如锁定账号）且已设置 Cookie，就用账号下载。已在资料库里的帖子也会放进所选文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對下面的連結下載和批次匯入書籤都生效。「自動」先用公開鏡像 FxTwitter，取不到時（例如鎖定帳號）且已設定 Cookie，就用帳號下載。已在資料庫裡的貼文也會放進所選資料夾。"
          }
        }
      }
    },
