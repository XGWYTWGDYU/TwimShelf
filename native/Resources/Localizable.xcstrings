    "sync.devices.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devices of the same account find each other on the local network and sync posts, media, tags and their sources. There is no central device; one that was offline catches up when it is back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じアカウントのデバイスは LAN で互いを見つけ、投稿・メディア・タグとその提供元を同期します。中心となるデバイスはなく、オフラインだったデバイスも戻れば追いつきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一账户的设备在局域网中自动发现并互相同步帖子、媒体、标签及其来源。没有中心设备，任意一台离线后再上线都会追上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一帳戶的裝置在區域網路中自動發現並互相同步貼文、媒體、標籤及其來源。沒有中心裝置，任一台離線後再上線都會追上。"
          }
        }
      }
    },
