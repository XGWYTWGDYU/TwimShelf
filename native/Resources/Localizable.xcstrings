    "tags.deleteAI.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only tags the AI added go; those you approved stay as your tags. This syncs to other devices and can't be undone. The AI won't analyze these media again on its own — re-tag them in AI Models when needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI が付けたタグだけが消えます。承認したタグは自分のタグとして残ります。ほかのデバイスにも同期され、取り消せません。AI はこれらのメディアを自動では再分析しないので、必要なら「AI モデル」で再タグ付けしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 AI 加的标签会消失；你认可过的会保留为你的标签。会同步到其他设备，无法撤销。AI 不会自动重新分析这些媒体，需要时可以在「AI 模型」里重新标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 AI 加的標籤會消失；你認可過的會保留為你的標籤。會同步到其他裝置，無法撤銷。AI 不會自動重新分析這些媒體，需要時可以在「AI 模型」裡重新標記。"
          }
        }
      }
    },
