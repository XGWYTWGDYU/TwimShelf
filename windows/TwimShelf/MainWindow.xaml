<?xml version="1.0" encoding="utf-8"?>
<!-- The main window, laid out as the Mac app's: a sidebar of places (folds away when narrow) and
     the content beside it; the title bar carries the page's title and subtitle and, like the Mac
     toolbar, the page's own controls (a grid's zoom and selection; 浏览 keeps its search in a bar
     of its own over the cards). What runs floats over every page at the bottom right. -->
<Window
    x:Class="TwimShelf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TwimShelf.Pages"
    Title="TwimShelf">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            Title="TwimShelf"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBack"
            PaneToggleRequested="OnPaneToggle">
            <TitleBar.Content>
                <ContentPresenter x:Name="TitleContent" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <ContentPresenter x:Name="TitleRight" VerticalAlignment="Center" Margin="0,0,4,0" />
            </TitleBar.RightHeader>
        </TitleBar>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="900"
            ExpandedModeThresholdWidth="900"
            OpenPaneLength="264"
            SelectionChanged="OnNavSelection"
            ItemInvoked="OnNavInvoked">
            <Grid x:Name="ContentHost">
                <Grid x:Name="PageHost" />
                <pages:ActivityPanel x:Name="Activity" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
